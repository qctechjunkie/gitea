# User and Group IDs
# Match these with the owner of your volume paths if using host volumes
USER_UID=1000
USER_GID=1000

# Database Configuration
# Options: sqlite3, mysql, postgres
DB_TYPE=sqlite3

# Server Configuration
# Your Gitea domain (without protocol)
GITEA_DOMAIN=git.example.com
# Full URL with protocol
GITEA_ROOT_URL=https://git.example.com

# SSH Configuration
# Domain for SSH connections
GITEA_SSH_DOMAIN=git.example.com
# External SSH port (what users connect to)
GITEA_SSH_PORT=2222
# Internal SSH port (container listens on port 22)
GITEA_SSH_LISTEN_PORT=22

# Service Settings
# Set to true to disable public registration
DISABLE_REGISTRATION=true

# Repository Settings
# Allow users to create repositories by pushing
ENABLE_PUSH_CREATE_USER=true
# Allow organizations to create repositories by pushing
ENABLE_PUSH_CREATE_ORG=true

# Volume Paths
# Adjust these paths to match your host system
GITEA_DATA_PATH=/path/to/gitea/data
GITEA_CONFIG_PATH=/path/to/gitea/config
TIMEZONE_PATH=/etc/timezone
LOCALTIME_PATH=/etc/localtime

# Port Mappings
# External HTTP port (e.g., 3000, 8080, 8181)
GITEA_HTTP_PORT=3000
