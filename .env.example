# Gitea Configuration
# Copy this file to .env and update with your values.
# Reference: https://docs.gitea.com/installation/install-with-docker

# Volume Paths
# Base directory for Gitea data. Two subdirs are created:
#   ${DOCKER_DATA_PATH}/data     -> Gitea app data (/data in container)
#   ${DOCKER_DATA_PATH}/postgres -> Postgres data (/var/lib/postgresql/data)
# Linux example:   /home/username/Docker/gitea
# Windows example: C:/Users/username/Docker/gitea
DOCKER_DATA_PATH=/path/to/your/gitea

# Timezone (find yours at https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=America/Chicago

# Image Tags
# Gitea tag. "1.27" tracks the latest 1.27.x release.
# Set to a full version (e.g. "1.27.0") for zero-surprise updates.
GITEA_TAG=1.27

# Postgres tag. Gitea supports Postgres 12+. 17 is current stable (EOL Nov 2029).
# Migrating an existing volume to a higher major requires a dump/restore.
POSTGRES_TAG=17

# User and Group IDs
# Match these with the owner of ${DOCKER_DATA_PATH} on the host.
USER_UID=1000
USER_GID=1000

# Port Mappings (host:container)
# HTTP port for the web UI.
GITEA_HTTP_PORT=3000
# SSH port for git-over-ssh. Container listens on 22; this is the host port
# AND the value Gitea advertises in clone URLs.
GITEA_SSH_PORT=2222

# Server URLs
# Your Gitea domain (without protocol).
GITEA_DOMAIN=git.example.com
# Full URL including protocol. Used to build clone URLs, webhooks, notification links.
GITEA_ROOT_URL=https://git.example.com
# Domain shown in SSH clone URLs. Defaults to GITEA_DOMAIN if unset.
GITEA_SSH_DOMAIN=git.example.com

# Service Settings
# Disable public sign-up (true recommended).
GITEA_DISABLE_REGISTRATION=true
# Allow users/orgs to create repos by pushing to a new URL.
GITEA_ENABLE_PUSH_CREATE_USER=true
GITEA_ENABLE_PUSH_CREATE_ORG=true
# auto | legacy — "auto" respects the Host header from your reverse proxy.
GITEA_PUBLIC_URL_DETECTION_MODE=auto

# SSH Commit Signing Verification
# Format: "ssh" enables SSH-signature verification (Gitea 1.24+).
# Users register an SSH key as a "signing key" on their profile and
# Gitea will verify commits signed with it.
GITEA_SIGNING_FORMAT=ssh
# Server-side signing key. "none" = Gitea does NOT sign anything itself
# (users bring their own keys). To have Gitea sign server-side actions,
# generate a keypair (ssh-keygen -t ed25519 -f gitea-signing-key), mount
# both files into /data/git/.ssh/, and set this to the pubkey path.
GITEA_SIGNING_KEY=none
GITEA_SIGNING_NAME=
GITEA_SIGNING_EMAIL=
# Verification policy for various actions. Values are comma-separated:
# never | always | pubkey | twofa | parentsigned | basesigned | commitssigned | approved
GITEA_SIGNING_INITIAL_COMMIT=never
GITEA_SIGNING_CRUD_ACTIONS=pubkey,twofa,parentsigned
GITEA_SIGNING_MERGES=pubkey,twofa,basesigned,commitssigned
GITEA_SIGNING_WIKI=never

# Database Configuration
POSTGRES_DB=gitea
POSTGRES_USER=gitea
# Required. Change to a random password (e.g. `openssl rand -base64 32`).
POSTGRES_PASSWORD=changeme_secure_password
